# syntax=docker/dockerfile:1.25

# =========================================================
# JBS Networks Navidrome Ultra 6.1 Slim v10.4 Stable Final
# AMD EPYC Zen3 Dedicated Edition 2
#
# Updated 2026-08-22:
#   - Go 1.27.0
#   - Bun 1.4.0 (1.4 canary)
#   - Rust 1.98.0
#   - FFmpeg 8.1.2
#   - jemalloc 5.3.1
#   - Opus 1.6.1
#   - LAME 3.100 (FFmpeg 8.1.x stable compatibility)
#   - rusqlite 0.40.1 Anti-hero
#
# Main fixes:
#   - Correct FFmpeg fallback preflight checks
#   - Make SQLite doctor validate returned rows
#   - Stop silently ignoring SQLite open failures
#   - Add cgroup v1/v2 CPU and memory detection
#   - Cap CPU quota by cpuset/nproc
#   - Avoid GOMEMLIMIT minimum exceeding tiny containers
#   - Verify /data, /cache and /music runtime paths
#   - Remove risky SQLITE_USE_ALLOCA
#   - Reduce per-connection SQLite memory for light servers (16MiB cache, 64MiB mmap)
#   - Ensure SQLITE amalgamation CFLAGS ride with fat LTO; PGO trains CGO sqlite hot path
#   - Validate FFmpeg capabilities at image build time
#   - Use two scanner I/O workers from 512MiB while keeping GOMAXPROCS cgroup-bound
#   - Precompress production UI with Brotli 11/9, Zstd 19 and gzip 9
#   - Drop production source maps and unused builder packages
#   - Use LLVM full (fat) LTO for every native component and final CGO link
#   - Train Go PGO with thin LTO, then apply the merged profile on the fat LTO build
#     (20 workloads — see release/pgo-train.sh for the final scenario table)
#   - Rust gRPC workers use release-fat (LLVM fat LTO); optional RUST_PGO_ENABLED
#     runs release/rust-pgo-train.sh (instrument hot workers only; one fat+PGO final link)
#   - Rust PGO instrument phase uses release-pgo-gen (LTO off, many CGUs) for speed
#   - ccache for jemalloc/opus/lame/ffmpeg native fat-LTO compiles
#
# NOTE:
#   Base images are pinned to the current multi-platform index digests
#   verified on 2026-08-22. Refresh these digests when versions change.
# =========================================================

ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258
ARG BUN_IMAGE=oven/bun:canary-debian@sha256:3fdb86090dadfc204a660d28494c79e465a477f532ae5dbe247343efad32f597
ARG GOLANG_IMAGE=golang:1.27.0-trixie@sha256:6212da3924947f4b6a939df02ea627c13f338f1a41d6c3fcb0dd9d076eef46c4
ARG RUST_IMAGE=rust:1.98.0-slim-trixie@sha256:cc0448b41c3b7b7fea44f5dc50eacba729a56db365b65b7bd5e8a82d5b3db078

ARG NAVIDROME_REPOSITORY=https://github.com/TAE-OK-11/navidrome.git
ARG NAVIDROME_REF=master
ARG NAVIDROME_CACHEBUST=da1ed9503b9ce8f121f648ec05f0ce78ac02ec09

ARG JEMALLOC_VERSION=5.3.1
ARG FFMPEG_VERSION=8.1.2
ARG OPUS_VERSION=1.6.1
ARG LAME_VERSION=3.100
ARG RUSQLITE_VERSION=0.40.1
ARG WALKDIR_VERSION=2.5.0

ARG NAVIDROME_BUILD_CORES=4
ARG STATIC_COMPRESSION_JOBS=4
ARG FFMPEG_THREADS=auto
ARG GOMEMLIMIT=auto
ARG GOMAXPROCS=auto
ARG GOGC=125
ARG SCANSCHEDULE=0
ARG GOAMD64_VERSION=v3
ARG RUST_TARGET_CPU=znver3

ARG JBS_GOMAXPROCS_MAX=4
ARG JBS_FFMPEG_THREADS_MAX=2
ARG JBS_GOMEMLIMIT_PERCENT=55
ARG JBS_GOMEMLIMIT_MIN_MIB=192
ARG JBS_GOMEMLIMIT_MAX_MIB=4096

ARG CPU_OPTIMIZATION_FLAGS="-O3 -march=znver3 -mtune=znver3 -DNDEBUG -ffunction-sections -fdata-sections -fno-semantic-interposition -pipe -fno-plt"
ARG LLVM_THIN_LTO_FLAGS="-flto=thin"
ARG LLVM_FAT_LTO_FLAGS="-flto=full"
ARG LLD_FLAGS="-fuse-ld=lld -Wl,-O2 -Wl,--lto-O3 -Wl,--gc-sections -Wl,--icf=safe -Wl,--as-needed -Wl,-z,relro,-z,now -Wl,--build-id=none"
ARG GO_PGO_ENABLED=true
ARG GO_PGO_BENCHTIME=1s
# Light Go PGO benches (auth/URL/SSE/…); keep short — heavy benches carry the signal.
ARG GO_PGO_LIGHT_BENCHTIME=100ms

# SQLite amalgamation flags for CGO (keep in sync with release/sqlite-cflags.sh).
# Light/EPYC profile: smaller default page cache + mmap than prior 32/128MiB to
# cut per-connection RSS under SQLITE_OMIT_SHARED_CACHE; DSN may still override
# cache_size. Fat LTO is applied via CGO_CFLAGS (-flto=full) in gobuilder.
ARG SQLITE_EXTRA_CFLAGS="\
-DSQLITE_ENABLE_FTS5 \
-DSQLITE_ENABLE_STAT4 \
-DSQLITE_OMIT_SHARED_CACHE \
-DSQLITE_DEFAULT_WAL_AUTOCHECKPOINT=1000 \
-DSQLITE_DEFAULT_WAL_SYNCHRONOUS=1 \
-DSQLITE_TEMP_STORE=2 \
-DSQLITE_DEFAULT_MMAP_SIZE=67108864 \
-DSQLITE_MAX_MMAP_SIZE=268435456 \
-DSQLITE_DEFAULT_CACHE_SIZE=-16384 \
-DSQLITE_DEFAULT_MEMSTATUS=0 \
-DSQLITE_LIKE_DOESNT_MATCH_BLOBS \
-DSQLITE_DQS=0 \
-DSQLITE_DEFAULT_FOREIGN_KEYS=1 \
-DSQLITE_ENABLE_UPDATE_DELETE_LIMIT \
-DSQLITE_OMIT_DEPRECATED \
-DSQLITE_USE_URI=1"

ARG JEMALLOC_SHA256=3826bc80232f22ed5c4662f3034f799ca316e819103bdc7bb99018a421706f92
ARG FFMPEG_SHA256=464beb5e7bf0c311e68b45ae2f04e9cc2af88851abb4082231742a74d97b524c
ARG OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1
ARG LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# =========================================================
# Source
# =========================================================

FROM ${DEBIAN_IMAGE} AS source

ARG NAVIDROME_REF
ARG NAVIDROME_REPOSITORY
ARG NAVIDROME_CACHEBUST

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      git

WORKDIR /src

RUN echo "NAVIDROME_CACHEBUST=${NAVIDROME_CACHEBUST}" >/dev/null && \
    git init . && \
    git remote add origin "${NAVIDROME_REPOSITORY}" && \
    if git ls-remote --exit-code --heads origin "${NAVIDROME_REF}" >/dev/null 2>&1; then \
      git fetch --depth=1 origin "refs/heads/${NAVIDROME_REF}"; \
    elif git ls-remote --exit-code --tags origin "${NAVIDROME_REF}" >/dev/null 2>&1; then \
      git fetch --depth=1 origin "refs/tags/${NAVIDROME_REF}"; \
    else \
      git fetch --depth=1 origin "${NAVIDROME_REF}"; \
    fi && \
    git checkout --detach FETCH_HEAD && \
    git rev-parse --short=12 HEAD > /src/.git_sha && \
    git show -s --format=%ct HEAD > /src/.git_epoch && \
    rm -rf .git

# =========================================================
# Shared native toolchain
# =========================================================

FROM ${DEBIAN_IMAGE} AS native-builder-base

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      bzip2 \
      ca-certificates \
      ccache \
      clang \
      file \
      libc6-dev \
      lld \
      llvm \
      make \
      nasm \
      pkg-config \
      wget \
      xz-utils

ENV PATH="/usr/lib/ccache:${PATH}" \
    CCACHE_DIR=/root/.cache/ccache \
    CCACHE_MAXSIZE=2G \
    CCACHE_COMPILERCHECK=content \
    CCACHE_SLOPPINESS=time_macros,include_file_mtime,include_file_ctime

# =========================================================
# jemalloc
# =========================================================

FROM native-builder-base AS jemalloc-builder

ARG JEMALLOC_VERSION
ARG JEMALLOC_SHA256
ARG NAVIDROME_BUILD_CORES
ARG CPU_OPTIMIZATION_FLAGS
ARG LLVM_FAT_LTO_FLAGS
ARG LLD_FLAGS

WORKDIR /build

RUN wget --https-only --tries=3 --max-redirect=3 -qO jemalloc.tar.bz2 \
      "https://github.com/jemalloc/jemalloc/releases/download/${JEMALLOC_VERSION}/jemalloc-${JEMALLOC_VERSION}.tar.bz2" && \
    echo "${JEMALLOC_SHA256}  jemalloc.tar.bz2" | sha256sum -c - && \
    tar -tjf jemalloc.tar.bz2 >/dev/null && \
    mkdir jemalloc && \
    tar -xjf jemalloc.tar.bz2 --strip-components=1 -C jemalloc

WORKDIR /build/jemalloc

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    CC="ccache clang" \
    CXX="ccache clang++" \
    AR=llvm-ar \
    RANLIB=llvm-ranlib \
    NM=llvm-nm \
    STRIP=llvm-strip \
    CFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
    CXXFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
    LDFLAGS="${LLVM_FAT_LTO_FLAGS} ${LLD_FLAGS}" \
    ./configure \
      --prefix=/usr/local \
      --disable-cxx \
      --disable-stats \
      --with-malloc-conf="background_thread:true,metadata_thp:disabled,narenas:2,dirty_decay_ms:5000,muzzy_decay_ms:10000,oversize_threshold:8388608,retain:false" && \
    make -j"${NAVIDROME_BUILD_CORES}" install && \
    find /usr/local/lib -name "libjemalloc.so.*" ! -type l -exec llvm-strip --strip-unneeded {} + && \
    ccache -s || true

# =========================================================
# libopus static
# =========================================================

FROM native-builder-base AS opus-builder

ARG OPUS_VERSION
ARG OPUS_SHA256
ARG NAVIDROME_BUILD_CORES
ARG CPU_OPTIMIZATION_FLAGS
ARG LLVM_FAT_LTO_FLAGS
ARG LLD_FLAGS

WORKDIR /build

RUN wget --https-only --tries=3 --max-redirect=3 -qO opus.tar.gz \
      "https://downloads.xiph.org/releases/opus/opus-${OPUS_VERSION}.tar.gz" && \
    echo "${OPUS_SHA256}  opus.tar.gz" | sha256sum -c - && \
    tar -tzf opus.tar.gz >/dev/null && \
    mkdir opus && \
    tar -xzf opus.tar.gz --strip-components=1 -C opus

WORKDIR /build/opus

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    CC="ccache clang" \
    CXX="ccache clang++" \
    AR=llvm-ar \
    RANLIB=llvm-ranlib \
    NM=llvm-nm \
    STRIP=llvm-strip \
    CFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
    CXXFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
    LDFLAGS="${LLVM_FAT_LTO_FLAGS} ${LLD_FLAGS}" \
    ./configure \
      --prefix=/usr/local \
      --disable-shared \
      --enable-static \
      --disable-extra-programs \
      --disable-doc && \
    make -j"${NAVIDROME_BUILD_CORES}" install && \
    llvm-ranlib /usr/local/lib/libopus.a

# =========================================================
# LAME MP3 encoder static
# Stable compatibility choice for FFmpeg 8.1.x
# =========================================================

FROM native-builder-base AS lame-builder

ARG LAME_VERSION
ARG LAME_SHA256
ARG NAVIDROME_BUILD_CORES
ARG CPU_OPTIMIZATION_FLAGS
ARG LLVM_FAT_LTO_FLAGS
ARG LLD_FLAGS

WORKDIR /build

RUN wget --https-only --tries=3 --max-redirect=3 -qO lame.tar.gz \
      "https://downloads.sourceforge.net/project/lame/lame/${LAME_VERSION}/lame-${LAME_VERSION}.tar.gz" && \
    echo "${LAME_SHA256}  lame.tar.gz" | sha256sum -c - && \
    tar -tzf lame.tar.gz >/dev/null && \
    mkdir lame && \
    tar -xzf lame.tar.gz --strip-components=1 -C lame

WORKDIR /build/lame

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    CC="ccache clang" \
    CXX="ccache clang++" \
    AR=llvm-ar \
    RANLIB=llvm-ranlib \
    NM=llvm-nm \
    STRIP=llvm-strip \
    CFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
    CXXFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
    LDFLAGS="${LLVM_FAT_LTO_FLAGS} ${LLD_FLAGS}" \
    ./configure \
      --prefix=/usr/local \
      --disable-shared \
      --enable-static \
      --disable-dependency-tracking \
      --disable-rpath \
      --enable-nasm \
      --disable-frontend \
      --disable-decoder \
      --disable-analyzer-hooks

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    make -j"${NAVIDROME_BUILD_CORES}" V=1 && \
    make install && \
    test -s /usr/local/lib/libmp3lame.a && \
    test -s /usr/local/include/lame/lame.h && \
    llvm-ranlib /usr/local/lib/libmp3lame.a && \
    ccache -s || true

RUN mkdir -p /usr/local/lib/pkgconfig && \
    printf '%s\n' \
      'prefix=/usr/local' \
      'exec_prefix=${prefix}' \
      'libdir=${exec_prefix}/lib' \
      'includedir=${prefix}/include' \
      '' \
      'Name: libmp3lame' \
      'Description: LAME MP3 encoder library' \
      "Version: ${LAME_VERSION}" \
      'Libs: -L${libdir} -lmp3lame' \
      'Libs.private: -lm' \
      'Cflags: -I${includedir}' \
      > /usr/local/lib/pkgconfig/libmp3lame.pc && \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig pkg-config --modversion libmp3lame && \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig pkg-config --libs --static libmp3lame

# =========================================================
# FFmpeg: audio-focused Opus / MP3 / AAC / FLAC
# =========================================================

FROM native-builder-base AS ffmpeg-builder

ARG FFMPEG_VERSION
ARG FFMPEG_SHA256
ARG NAVIDROME_BUILD_CORES
ARG CPU_OPTIMIZATION_FLAGS
ARG LLVM_FAT_LTO_FLAGS
ARG LLD_FLAGS

COPY --from=opus-builder /usr/local/lib/libopus.a /usr/local/lib/
COPY --from=opus-builder /usr/local/lib/pkgconfig/opus.pc /usr/local/lib/pkgconfig/
COPY --from=opus-builder /usr/local/include/opus /usr/local/include/opus

COPY --from=lame-builder /usr/local/lib/libmp3lame.a /usr/local/lib/
COPY --from=lame-builder /usr/local/lib/pkgconfig/libmp3lame.pc /usr/local/lib/pkgconfig/
COPY --from=lame-builder /usr/local/include/lame /usr/local/include/lame

ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig

RUN pkg-config --modversion opus && \
    pkg-config --modversion libmp3lame && \
    pkg-config --libs --static opus && \
    pkg-config --libs --static libmp3lame && \
    test -s /usr/local/include/lame/lame.h && \
    test -s /usr/local/lib/libopus.a && \
    test -s /usr/local/lib/libmp3lame.a

WORKDIR /build

RUN wget --https-only --tries=3 --max-redirect=3 -qO ffmpeg.tar.xz \
      "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" && \
    echo "${FFMPEG_SHA256}  ffmpeg.tar.xz" | sha256sum -c - && \
    tar -tJf ffmpeg.tar.xz >/dev/null && \
    mkdir ffmpeg && \
    tar -xJf ffmpeg.tar.xz --strip-components=1 -C ffmpeg

WORKDIR /build/ffmpeg

# Keep configure separate so its real failure is visible in BuildKit logs.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    set -eu; \
    if ! ./configure \
      --prefix=/usr/local \
      --cc="ccache clang" \
      --cxx="ccache clang++" \
      --ar=llvm-ar \
      --ranlib=llvm-ranlib \
      --nm=llvm-nm \
      --strip=llvm-strip \
      --pkg-config=pkg-config \
      --pkg-config-flags=--static \
      --target-os=linux \
      --arch=x86_64 \
      --cpu=znver3 \
      --disable-runtime-cpudetect \
      --enable-hardcoded-tables \
      --disable-autodetect \
      --disable-network \
      --disable-debug \
      --disable-doc \
      --disable-avdevice \
      --disable-swscale \
      --disable-ffplay \
      --enable-ffprobe \
      --disable-everything \
      --enable-static \
      --disable-shared \
      --extra-cflags="-I/usr/local/include ${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
      --extra-ldflags="-L/usr/local/lib ${LLVM_FAT_LTO_FLAGS} ${LLD_FLAGS}" \
      --extra-libs="-lm" \
      --enable-avcodec \
      --enable-avformat \
      --enable-avfilter \
      --enable-swresample \
      --enable-protocol=file,pipe \
      --enable-demuxer=mov,mp3,aac,flac,ogg,pcm_s16le \
      --enable-decoder=alac,aac,mp3,mp3float,flac,opus,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le \
      --enable-parser=aac,mpegaudio,flac,opus \
      --enable-encoder=libopus,libmp3lame,aac,flac,pcm_s16le \
      --enable-muxer=ogg,opus,mp3,adts,wav,flac \
      --enable-filter=anull,aresample,aformat,volume,atrim,afade \
      --enable-bsf=aac_adtstoasc \
      --enable-libopus \
      --enable-libmp3lame; then \
        echo '========== FFmpeg configure failed ==========' >&2; \
        if [ -f ffbuild/config.log ]; then tail -n 240 ffbuild/config.log >&2; fi; \
        exit 1; \
    fi

# Keep compilation separate from capability tests.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    make -j"${NAVIDROME_BUILD_CORES}" V=1 && \
    install -Dm755 ffmpeg /usr/local/bin/ffmpeg && \
    install -Dm755 ffprobe /usr/local/bin/ffprobe && \
    test -x /usr/local/bin/ffmpeg && \
    test -x /usr/local/bin/ffprobe && \
    llvm-strip --strip-unneeded /usr/local/bin/ffmpeg /usr/local/bin/ffprobe && \
    ccache -s || true

# Validate enabled components using the component-name field rather than output spacing.
RUN set -eu; \
    /usr/local/bin/ffmpeg -hide_banner -encoders > /tmp/encoders.txt 2>&1; \
    /usr/local/bin/ffmpeg -hide_banner -decoders > /tmp/decoders.txt 2>&1; \
    /usr/local/bin/ffmpeg -hide_banner -demuxers > /tmp/demuxers.txt 2>&1; \
    /usr/local/bin/ffmpeg -hide_banner -muxers > /tmp/muxers.txt 2>&1; \
    /usr/local/bin/ffmpeg -hide_banner -filters > /tmp/filters.txt 2>&1; \
    require_ffmpeg_entry() { \
      file="$1"; \
      wanted="$2"; \
      kind="$3"; \
      if awk -v wanted="$wanted" ' \
        { \
          count = split($2, names, ","); \
          for (i = 1; i <= count; i++) { \
            if (names[i] == wanted) { \
              found = 1; \
              exit; \
            } \
          } \
        } \
        END { \
          exit(found ? 0 : 1); \
        } \
      ' "$file"; then \
        printf "[ffmpeg-check] %-8s %s: ok\n" "$kind" "$wanted"; \
      else \
        printf "[ffmpeg-check] missing %s: %s\n" "$kind" "$wanted" >&2; \
        printf "%s\n" "========== FFmpeg capability output ==========" >&2; \
        cat "$file" >&2; \
        exit 1; \
      fi; \
    }; \
    for name in libopus libmp3lame aac flac pcm_s16le; do \
      require_ffmpeg_entry /tmp/encoders.txt "$name" encoder; \
    done; \
    for name in alac aac mp3 flac opus pcm_s16le pcm_s24le pcm_s32le pcm_f32le; do \
      require_ffmpeg_entry /tmp/decoders.txt "$name" decoder; \
    done; \
    for name in mov mp3 aac flac ogg s16le; do \
      require_ffmpeg_entry /tmp/demuxers.txt "$name" demuxer; \
    done; \
    for name in ogg opus mp3 adts wav flac; do \
      require_ffmpeg_entry /tmp/muxers.txt "$name" muxer; \
    done; \
    for name in anull aresample aformat volume atrim afade; do \
      require_ffmpeg_entry /tmp/filters.txt "$name" filter; \
    done; \
    rm -f /tmp/encoders.txt /tmp/decoders.txt /tmp/demuxers.txt /tmp/muxers.txt /tmp/filters.txt

# Actual encode tests catch ABI/LTO/static-link incompatibilities.
RUN set -eu; \
    dd if=/dev/zero of=/tmp/jbs-silence.s16le bs=192000 count=1 status=none; \
    /usr/local/bin/ffmpeg -nostdin -hide_banner -loglevel error -y \
      -f s16le -ar 48000 -ac 2 -i /tmp/jbs-silence.s16le \
      -c:a libmp3lame -b:a 192k -f mp3 /tmp/jbs-test.mp3; \
    /usr/local/bin/ffmpeg -nostdin -hide_banner -loglevel error -y \
      -f s16le -ar 48000 -ac 2 -i /tmp/jbs-silence.s16le \
      -c:a libopus -b:a 128k -f opus /tmp/jbs-test.opus; \
    /usr/local/bin/ffmpeg -nostdin -hide_banner -loglevel error -y \
      -f s16le -ar 48000 -ac 2 -i /tmp/jbs-silence.s16le \
      -c:a aac -b:a 192k -f adts /tmp/jbs-test.aac; \
    /usr/local/bin/ffmpeg -nostdin -hide_banner -loglevel error -y \
      -f s16le -ar 48000 -ac 2 -i /tmp/jbs-silence.s16le \
      -c:a flac -compression_level 5 -f flac /tmp/jbs-test.flac; \
    test -s /tmp/jbs-test.mp3; \
    test -s /tmp/jbs-test.opus; \
    test -s /tmp/jbs-test.aac; \
    test -s /tmp/jbs-test.flac; \
    rm -f /tmp/jbs-silence.s16le /tmp/jbs-test.mp3 /tmp/jbs-test.opus /tmp/jbs-test.aac /tmp/jbs-test.flac

# Opus/LAME must be linked statically; standard libc/libm may stay dynamic.
RUN set -eu; \
    ffdeps="$(ldd /usr/local/bin/ffmpeg 2>&1 || true)"; \
    printf '%s\n' "$ffdeps"; \
    case "$ffdeps" in \
      *"not found"*) echo 'FFmpeg has unresolved dynamic dependencies' >&2; exit 1 ;; \
      *libopus.so*|*libmp3lame.so*) echo 'FFmpeg unexpectedly links dynamically to Opus/LAME' >&2; exit 1 ;; \
      *) : ;; \
    esac; \
    file /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

# =========================================================
# Rust unified helper
# =========================================================

FROM ${RUST_IMAGE} AS rust-builder

ARG NAVIDROME_BUILD_CORES
ARG RUST_TARGET_CPU
ARG RUSQLITE_VERSION
ARG WALKDIR_VERSION

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      musl-tools && \
    rustup target add x86_64-unknown-linux-musl

WORKDIR /build

RUN mkdir -p src && \
    cat > Cargo.toml <<TOML
[package]
name = "jbs-helper"
version = "0.1.0"
edition = "2024"

[dependencies]
rusqlite = { version = "=${RUSQLITE_VERSION}", features = ["bundled"] }
walkdir = "=${WALKDIR_VERSION}"

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
strip = "symbols"
panic = "abort"
TOML

RUN cat > src/main.rs <<'RUST'
use std::env;
use std::fs::File;
use std::io::{Read, Write};
use std::net::{SocketAddr, TcpStream};
use std::path::Path;
use std::process::Command;
use std::time::Duration;

use rusqlite::{Connection, OpenFlags};
use walkdir::WalkDir;

const CHUNK: usize = 1024 * 1024;

fn basename(path: &str) -> &str {
    path.rsplit('/').next().unwrap_or(path)
}

fn is_cmd(name: &str, needle: &str) -> bool {
    name == needle || name.ends_with(needle)
}

fn tcp_listener_present(port: u16) -> bool {
    let expected_port = format!("{port:04X}");

    for path in ["/proc/net/tcp", "/proc/net/tcp6"] {
        let Ok(contents) = std::fs::read_to_string(path) else {
            continue;
        };

        for line in contents.lines().skip(1) {
            let fields: Vec<_> = line.split_whitespace().collect();
            if fields.len() < 4 || fields[3] != "0A" {
                continue;
            }
            let Some((_, port_hex)) = fields[1].rsplit_once(':') else {
                continue;
            };
            if port_hex.eq_ignore_ascii_case(&expected_port) {
                return true;
            }
        }
    }

    false
}

fn run_healthcheck() -> i32 {
    let port: u16 = env::var("ND_PORT")
        .unwrap_or_default()
        .parse()
        .unwrap_or(4533);

    let addr = SocketAddr::from(([127, 0, 0, 1], port));
    let timeout = Duration::from_secs(4);

    // Opening and immediately closing a raw TCP connection against a TLS
    // listener produces a noisy handshake EOF every healthcheck interval.
    // The slim runtime intentionally has no TLS client, so inspect the kernel
    // listener table in TLS mode and retain the HTTP probe for plaintext mode.
    let tls_enabled = env::var("ND_TLSCERT").is_ok_and(|value| !value.trim().is_empty())
        && env::var("ND_TLSKEY").is_ok_and(|value| !value.trim().is_empty());
    if tls_enabled {
        return if tcp_listener_present(port) { 0 } else { 1 };
    }

    let mut stream = match TcpStream::connect_timeout(&addr, timeout) {
        Ok(stream) => stream,
        Err(_) => return 1,
    };

    if stream.set_read_timeout(Some(timeout)).is_err()
        || stream.set_write_timeout(Some(timeout)).is_err()
    {
        return 1;
    }

    let req = format!(
        "GET /ping HTTP/1.0\r\nHost: 127.0.0.1:{port}\r\nConnection: close\r\n\r\n"
    );

    if stream.write_all(req.as_bytes()).is_err() {
        return 1;
    }

    let mut response = Vec::with_capacity(1024);
    let mut buf = [0u8; 512];

    while response.len() < 4096 {
        match stream.read(&mut buf) {
            Ok(0) => break,
            Ok(n) => {
                response.extend_from_slice(&buf[..n]);
                if response.windows(4).any(|w| w == b"\r\n\r\n") {
                    break;
                }
            }
            Err(_) => return 1,
        }
    }

    let status_line = response
        .split(|b| *b == b'\n')
        .next()
        .and_then(|line| std::str::from_utf8(line).ok())
        .unwrap_or("")
        .trim_end_matches('\r');

    if status_line.starts_with("HTTP/1.") && status_line.contains(" 200 ") {
        0
    } else {
        1
    }
}

fn db_file_from_nd_dbpath(value: &str) -> Option<String> {
    let mut value = value.trim();

    if let Some(stripped) = value.strip_prefix("file:") {
        value = stripped;
    }

    let file = value.split('?').next().unwrap_or("").trim();

    if file.is_empty() || file == ":memory:" {
        return None;
    }

    Some(file.to_string())
}

fn open_db() -> Result<Option<Connection>, String> {
    let db_path = env::var("ND_DBPATH").unwrap_or_else(|_| {
        "file:/data/navidrome.db?mode=rwc&_journal_mode=WAL&_synchronous=NORMAL".to_string()
    });

    let Some(file) = db_file_from_nd_dbpath(&db_path) else {
        return Ok(None);
    };

    if !Path::new(&file).exists() {
        eprintln!("[sqlite-maint] database does not exist yet: {file}");
        return Ok(None);
    }

    let uri = format!("file:{file}?mode=rw");
    let conn = Connection::open_with_flags(
        &uri,
        OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_URI,
    )
    .map_err(|err| format!("open {file}: {err}"))?;

    conn.busy_timeout(Duration::from_secs(120))
        .map_err(|err| format!("busy timeout: {err}"))?;

    Ok(Some(conn))
}

fn run_sql(label: &str, sql: &str) -> i32 {
    let conn = match open_db() {
        Ok(Some(conn)) => conn,
        Ok(None) => return 0,
        Err(err) => {
            eprintln!("[sqlite-maint] {label}: failed: {err}");
            return 1;
        }
    };

    match conn.execute_batch(sql) {
        Ok(_) => {
            eprintln!("[sqlite-maint] {label}: ok");
            0
        }
        Err(err) => {
            eprintln!("[sqlite-maint] {label}: failed: {err}");
            1
        }
    }
}

fn check_pragma(conn: &Connection, pragma: &str) -> Result<(), String> {
    let mut stmt = conn
        .prepare(pragma)
        .map_err(|err| format!("{pragma}: prepare failed: {err}"))?;

    let rows = stmt
        .query_map([], |row| row.get::<_, String>(0))
        .map_err(|err| format!("{pragma}: query failed: {err}"))?;

    let mut problems = Vec::new();

    for row in rows {
        let value = row.map_err(|err| format!("{pragma}: row failed: {err}"))?;
        if !value.eq_ignore_ascii_case("ok") {
            problems.push(value);
        }
    }

    if problems.is_empty() {
        Ok(())
    } else {
        Err(format!("{pragma}: {}", problems.join(" | ")))
    }
}

fn run_sqlite_doctor() -> i32 {
    let conn = match open_db() {
        Ok(Some(conn)) => conn,
        Ok(None) => return 0,
        Err(err) => {
            eprintln!("[sqlite-maint] doctor: failed: {err}");
            return 1;
        }
    };

    for pragma in ["PRAGMA quick_check;", "PRAGMA integrity_check;"] {
        if let Err(err) = check_pragma(&conn, pragma) {
            eprintln!("[sqlite-maint] doctor: failed: {err}");
            return 1;
        }
    }

    eprintln!("[sqlite-maint] doctor: ok");
    0
}

fn run_sqlite_maint(args: &[String]) -> i32 {
    let mode = args.first().map(String::as_str).unwrap_or("startup");

    match mode {
        "startup" => run_sql(
            "startup",
            "
            PRAGMA journal_mode=WAL;
            PRAGMA synchronous=NORMAL;
            PRAGMA foreign_keys=ON;
            PRAGMA temp_store=MEMORY;
            PRAGMA mmap_size=67108864;
            PRAGMA analysis_limit=2000;
            PRAGMA optimize=0x10002;
            PRAGMA wal_checkpoint(PASSIVE);
            PRAGMA shrink_memory;
            ",
        ),
        "idle" => run_sql(
            "idle",
            "
            PRAGMA analysis_limit=1000;
            PRAGMA optimize;
            PRAGMA wal_checkpoint(PASSIVE);
            PRAGMA shrink_memory;
            ",
        ),
        "shutdown" => run_sql(
            "shutdown",
            "
            PRAGMA optimize;
            PRAGMA wal_checkpoint(TRUNCATE);
            PRAGMA shrink_memory;
            ",
        ),
        "doctor" => run_sqlite_doctor(),
        _ => {
            eprintln!("[sqlite-maint] usage: jbs-sqlite-maint [startup|idle|shutdown|doctor]");
            2
        }
    }
}

fn parse_limit_mb(args: &[String]) -> u64 {
    let mut i = 0;

    while i < args.len() {
        if args[i] == "--limit-mb" {
            if let Some(value) = args.get(i + 1) {
                return value.parse::<u64>().unwrap_or(32);
            }
        }
        i += 1;
    }

    env::var("JBS_CACHE_WARM_LIMIT_MB")
        .ok()
        .and_then(|value| value.parse::<u64>().ok())
        .unwrap_or(32)
}

fn read_some(path: &Path, remaining: &mut u64, buf: &mut [u8]) -> u64 {
    if *remaining == 0 {
        return 0;
    }

    let Ok(mut file) = File::open(path) else {
        return 0;
    };

    let before = *remaining;

    loop {
        if *remaining == 0 {
            break;
        }

        let want = (*remaining).min(buf.len() as u64) as usize;

        match file.read(&mut buf[..want]) {
            Ok(0) => break,
            Ok(n) => *remaining = remaining.saturating_sub(n as u64),
            Err(_) => break,
        }
    }

    before.saturating_sub(*remaining)
}

fn warm_fixed_db_files(data: &str, remaining: &mut u64, buf: &mut [u8]) {
    let files = [
        format!("{data}/navidrome.db"),
        format!("{data}/navidrome.db-wal"),
        format!("{data}/navidrome.db-shm"),
    ];

    for file in files {
        if *remaining == 0 {
            break;
        }

        let path = Path::new(&file);
        let read = read_some(path, remaining, buf);

        if read > 0 {
            eprintln!("[cache-warm] warmed {} bytes from {}", read, path.display());
        }
    }
}

fn run_cache_warm(args: &[String]) -> i32 {
    let mut remaining = parse_limit_mb(args).saturating_mul(1024 * 1024);

    if remaining == 0 {
        return 0;
    }

    let data = env::var("ND_DATAFOLDER").unwrap_or_else(|_| "/data".to_string());
    let cache = env::var("ND_CACHEFOLDER").unwrap_or_else(|_| "/cache".to_string());
    let mut buf = vec![0u8; CHUNK];

    warm_fixed_db_files(&data, &mut remaining, &mut buf);

    let mut seen = 0usize;

    for entry in WalkDir::new(cache)
        .max_depth(3)
        .follow_links(false)
        .into_iter()
        .filter_map(Result::ok)
    {
        if remaining == 0 || seen >= 128 {
            break;
        }

        if entry.file_type().is_file() {
            let read = read_some(entry.path(), &mut remaining, &mut buf);
            if read > 0 {
                eprintln!(
                    "[cache-warm] warmed {} bytes from {}",
                    read,
                    entry.path().display()
                );
            }
            seen += 1;
        }
    }

    eprintln!("[cache-warm] done");
    0
}

fn ffmpeg_path() -> String {
    let configured =
        env::var("ND_FFMPEGPATH").unwrap_or_else(|_| "/usr/local/bin/ffmpeg".to_string());

    let real_candidate = format!("{configured}.real");

    if Path::new(&real_candidate).exists() {
        real_candidate
    } else {
        configured
    }
}

fn capture_ffmpeg(args: &[&str]) -> Result<String, String> {
    let output = Command::new(ffmpeg_path())
        .args(args)
        .output()
        .map_err(|err| err.to_string())?;

    let mut text = String::new();
    text.push_str(&String::from_utf8_lossy(&output.stdout));
    text.push_str(&String::from_utf8_lossy(&output.stderr));

    if output.status.success() {
        Ok(text)
    } else {
        Err(text)
    }
}

fn has_named_entry(output: &str, name: &str) -> bool {
    output.lines().any(|line| {
        line.split_whitespace()
            .nth(1)
            .is_some_and(|entry| entry.split(',').any(|item| item == name))
    })
}

fn require_entries(
    output: &str,
    kind: &str,
    names: &[&str],
    failures: &mut Vec<String>,
) {
    for name in names {
        if !has_named_entry(output, name) {
            failures.push(format!("{kind}:{name}"));
        }
    }
}

fn run_ffmpeg_preflight(args: &[String]) -> i32 {
    let strict = args.iter().any(|arg| arg == "--strict");
    let path = ffmpeg_path();

    let decoders = capture_ffmpeg(&["-hide_banner", "-decoders"]).unwrap_or_default();
    let encoders = capture_ffmpeg(&["-hide_banner", "-encoders"]).unwrap_or_default();
    let demuxers = capture_ffmpeg(&["-hide_banner", "-demuxers"]).unwrap_or_default();
    let muxers = capture_ffmpeg(&["-hide_banner", "-muxers"]).unwrap_or_default();
    let filters = capture_ffmpeg(&["-hide_banner", "-filters"]).unwrap_or_default();

    let mut failures = Vec::new();

    require_entries(
        &decoders,
        "decoder",
        &["alac", "aac", "mp3", "flac", "opus"],
        &mut failures,
    );
    require_entries(
        &encoders,
        "encoder",
        &["libopus", "libmp3lame", "aac", "flac", "pcm_s16le"],
        &mut failures,
    );
    require_entries(
        &demuxers,
        "demuxer",
        &["mov", "mp3", "aac", "flac", "ogg"],
        &mut failures,
    );
    require_entries(
        &muxers,
        "muxer",
        &["ogg", "opus", "mp3", "adts", "wav", "flac"],
        &mut failures,
    );
    require_entries(
        &filters,
        "filter",
        &["aresample", "aformat", "volume"],
        &mut failures,
    );

    if failures.is_empty() {
        eprintln!("[ffmpeg-preflight] ok: {path}");
        return 0;
    }

    eprintln!(
        "[ffmpeg-preflight] missing capabilities from {path}: {}",
        failures.join(", ")
    );

    if strict { 1 } else { 0 }
}

fn print_usage() -> i32 {
    eprintln!(
        "usage: jbs-helper [healthcheck|sqlite-maint|cache-warm|ffmpeg-preflight] [args...]"
    );
    2
}

fn main() {
    let mut args: Vec<String> = env::args().collect();
    let argv0 = args
        .first()
        .cloned()
        .unwrap_or_else(|| "jbs-helper".to_string());
    let name = basename(&argv0).to_string();

    let code = if is_cmd(&name, "healthcheck") {
        run_healthcheck()
    } else if is_cmd(&name, "jbs-sqlite-maint") {
        let sub_args = args.split_off(1);
        run_sqlite_maint(&sub_args)
    } else if is_cmd(&name, "jbs-cache-warm") {
        let sub_args = args.split_off(1);
        run_cache_warm(&sub_args)
    } else if is_cmd(&name, "jbs-ffmpeg-preflight") {
        let sub_args = args.split_off(1);
        run_ffmpeg_preflight(&sub_args)
    } else {
        let Some(cmd) = args.get(1).cloned() else {
            std::process::exit(print_usage());
        };

        let sub_args: Vec<String> = args.into_iter().skip(2).collect();

        match cmd.as_str() {
            "healthcheck" => run_healthcheck(),
            "sqlite-maint" => run_sqlite_maint(&sub_args),
            "cache-warm" => run_cache_warm(&sub_args),
            "ffmpeg-preflight" => run_ffmpeg_preflight(&sub_args),
            _ => print_usage(),
        }
    };

    std::process::exit(code);
}
RUST

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc \
    CC_x86_64_unknown_linux_musl=musl-gcc \
    CFLAGS_x86_64_unknown_linux_musl="-O3 -march=znver3 -mtune=znver3 -DNDEBUG -ffunction-sections -fdata-sections -pipe" \
    RUSTFLAGS="-C target-cpu=${RUST_TARGET_CPU} -C target-feature=+crt-static" \
    cargo generate-lockfile && \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc \
    CC_x86_64_unknown_linux_musl=musl-gcc \
    CFLAGS_x86_64_unknown_linux_musl="-O3 -march=znver3 -mtune=znver3 -DNDEBUG -ffunction-sections -fdata-sections -pipe" \
    RUSTFLAGS="-C target-cpu=${RUST_TARGET_CPU} -C target-feature=+crt-static" \
    cargo build \
      --release \
      --locked \
      --target x86_64-unknown-linux-musl \
      -j"${NAVIDROME_BUILD_CORES}" && \
    mkdir -p /out && \
    cp target/x86_64-unknown-linux-musl/release/jbs-helper /out/jbs-helper && \
    test -x /out/jbs-helper

# =========================================================
# Rust gRPC workers (workspace)
# metadata, scanner, search, apikeys, integration
# =========================================================

FROM ${RUST_IMAGE} AS rust-workers-builder

ARG NAVIDROME_BUILD_CORES
ARG RUST_TARGET_CPU
ARG RUST_PGO_ENABLED=true
ARG RUST_PGO_BENCH_TIME=2

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt,sharing=locked apt-get update && apt-get install -y --no-install-recommends ca-certificates clang llvm lld

WORKDIR /build/rust

COPY --link --from=source /src/rust/Cargo.toml /src/rust/Cargo.lock ./
COPY --link --from=source /src/rust/fts-normalize ./fts-normalize
COPY --link --from=source /src/rust/grpc-listen ./grpc-listen
COPY --link --from=source /src/rust/apikeys ./apikeys
COPY --link --from=source /src/rust/integration ./integration
COPY --link --from=source /src/rust/metadata ./metadata
COPY --link --from=source /src/rust/scanner ./scanner
COPY --link --from=source /src/rust/search ./search
COPY --link --from=source /src/rust/benchmarks/integration /build/rust/benchmarks/integration
COPY --link --from=source /src/rust/benchmarks/metadata /build/rust/benchmarks/metadata
COPY --link --from=source /src/rust/benchmarks/scanner /build/rust/benchmarks/scanner
COPY --link --from=source /src/rust/benchmarks/search /build/rust/benchmarks/search
COPY --link --from=source /src/release/rust-pgo-train.sh /src/release/rust-build.sh /build/release/
COPY --link --from=source /src/proto /build/proto
COPY --link --from=source /src/resources/mime_types.yaml /build/resources/mime_types.yaml
COPY --link --from=source /src/core/artwork/e2e/testdata/embedded_art.mp3 /tmp/embedded_art.mp3

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    CARGO_BUILD_JOBS="${NAVIDROME_BUILD_CORES}" \
    CARGO_INCREMENTAL=0 \
    CARGO_TARGET_DIR=/tmp/rust-workers-portable \
    RUSTFLAGS="-C target-cpu=x86-64" \
    cargo test --locked --release && \
    CARGO_BUILD_JOBS="${NAVIDROME_BUILD_CORES}" \
    CARGO_INCREMENTAL=0 \
    CARGO_TARGET_DIR=/tmp/rust-workers-portable \
    RUSTFLAGS="-C target-cpu=x86-64" \
    cargo build --locked --release --bins && \
    /tmp/rust-workers-portable/release/navidrome-metadata --extract-picture /tmp/embedded_art.mp3 > /tmp/embedded-cover.bin && \
    test -s /tmp/embedded-cover.bin && \
    printf '%s\n' '{"root":"/tmp","targets":["."],"follow_symlinks":false,"ignore_dot_folders":true}' \
      | /tmp/rust-workers-portable/release/navidrome-scanner | grep -q '"kind":"done"' && \
    printf '%s\n' '{"op":"search_all","query":"","searches":[]}' \
      | /tmp/rust-workers-portable/release/navidrome-search | grep -q '"protocol":1' && \
    install -D -m 755 /tmp/rust-workers-portable/release/navidrome-scanner /out/navidrome-scanner-portable && \
    if [ "${RUST_PGO_ENABLED}" = "true" ]; then \
      chmod +x /build/release/rust-pgo-train.sh && \
      RUST_PGO_BENCH_TIME="${RUST_PGO_BENCH_TIME}" \
      CARGO_BUILD_JOBS="${NAVIDROME_BUILD_CORES}" \
      CARGO_INCREMENTAL=0 \
      CARGO_TARGET_DIR=/tmp/rust-workers-release \
      RUSTFLAGS="-C target-cpu=${RUST_TARGET_CPU}" \
      /build/release/rust-pgo-train.sh && \
      RUST_OUT=/tmp/rust-workers-release/pgo-final/release-fat; \
    else \
      CARGO_BUILD_JOBS="${NAVIDROME_BUILD_CORES}" \
      CARGO_INCREMENTAL=0 \
      CARGO_TARGET_DIR=/tmp/rust-workers-release \
      RUSTFLAGS="-C target-cpu=${RUST_TARGET_CPU}" \
      cargo build --locked --profile release-fat --bins && \
      RUST_OUT=/tmp/rust-workers-release/release-fat; \
    fi && \
    install -D -m 755 ${RUST_OUT}/navidrome-metadata /out/navidrome-metadata && \
    install -D -m 755 ${RUST_OUT}/navidrome-apikeys /out/navidrome-apikeys && \
    install -D -m 755 ${RUST_OUT}/navidrome-scanner /out/navidrome-scanner && \
    install -D -m 755 ${RUST_OUT}/navidrome-search /out/navidrome-search && \
    install -D -m 755 ${RUST_OUT}/navidrome-integration /out/navidrome-integration && \
    test -x /out/navidrome-metadata && \
    test -x /out/navidrome-apikeys && \
    test -x /out/navidrome-scanner && \
    test -x /out/navidrome-search && \
    test -x /out/navidrome-integration

# =========================================================
# Tokio-quiche HTTP/3 companion (release profile: fat LTO)
# =========================================================

FROM ${RUST_IMAGE} AS h3-builder

ARG NAVIDROME_BUILD_CORES
ARG RUST_TARGET_CPU

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      clang \
      cmake \
      git \
      make \
      ninja-build \
      perl \
      pkg-config

WORKDIR /build

COPY --link --from=source /src/rust/h3-gateway/Cargo.toml /src/rust/h3-gateway/Cargo.lock ./

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    mkdir src && \
    printf 'fn main() {}\n' > src/main.rs && \
    CARGO_BUILD_JOBS="${NAVIDROME_BUILD_CORES}" \
    CARGO_INCREMENTAL=0 \
    RUSTFLAGS="-C target-cpu=${RUST_TARGET_CPU}" \
    cargo build --locked --release && \
    rm -rf src target/release/deps/navidrome_h3-* target/release/navidrome-h3

COPY --link --from=source /src/rust/h3-gateway/src ./src

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    CARGO_BUILD_JOBS="${NAVIDROME_BUILD_CORES}" \
    CARGO_INCREMENTAL=0 \
    CARGO_TARGET_DIR=/tmp/h3-test \
    RUSTFLAGS="-C target-cpu=x86-64" \
    cargo test --locked --release && \
    CARGO_BUILD_JOBS="${NAVIDROME_BUILD_CORES}" \
    CARGO_INCREMENTAL=0 \
    RUSTFLAGS="-C target-cpu=${RUST_TARGET_CPU}" \
    cargo build --locked --release && \
    install -D -m 755 target/release/navidrome-h3 /out/navidrome-h3 && \
    test -x /out/navidrome-h3

# =========================================================
# UI build
# =========================================================

FROM ${BUN_IMAGE} AS jsbuilder

ARG STATIC_COMPRESSION_JOBS

WORKDIR /src/ui

ENV ND_UI_SOURCEMAP=false \
    STATIC_COMPRESSION_JOBS=${STATIC_COMPRESSION_JOBS}

COPY --link --from=source /src/ui/package.json /src/ui/bun.lock ./
COPY --link --from=source /src/ui/bin/ ./bin/

RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    test -s ./bin/update-workbox.ts && \
    bun install --frozen-lockfile --prefer-offline

COPY --link --from=source /src/ui ./

RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun run build && \
    test -s ./build/index.html && \
    br_count="$(find ./build -type f -name '*.br' | wc -l)" && \
    zst_count="$(find ./build -type f -name '*.zst' | wc -l)" && \
    gz_count="$(find ./build -type f -name '*.gz' | wc -l)" && \
    test "${br_count}" -gt 0 && \
    test "${zst_count}" -gt 0 && \
    test "${gz_count}" -gt 0 && \
    test -z "$(find ./build -type f -name '*.map' -print -quit)" && \
    js_bundle="$(find ./build/assets -type f -name 'index-*.js' -print -quit)" && \
    test -n "${js_bundle}" && \
    test -s "${js_bundle}.br" && \
    test -s "${js_bundle}.zst" && \
    test -s "${js_bundle}.gz" && \
    css_bundle="$(find ./build/assets -type f -name 'index-*.css' -print -quit)" && \
    test -n "${css_bundle}" && \
    test -s "${css_bundle}.br" && \
    test -s "${css_bundle}.zst" && \
    test -s "${css_bundle}.gz" && \
    printf '[jsbuilder] precompressed UI assets: br=%s zstd=%s gz=%s\n' \
      "${br_count}" \
      "${zst_count}" \
      "${gz_count}"

# =========================================================
# Go / Navidrome build
# =========================================================

FROM ${GOLANG_IMAGE} AS gobuilder

ARG NAVIDROME_REF
ARG NAVIDROME_BUILD_CORES
ARG CPU_OPTIMIZATION_FLAGS
ARG LLVM_THIN_LTO_FLAGS
ARG LLVM_FAT_LTO_FLAGS
ARG LLD_FLAGS
ARG GOAMD64_VERSION
ARG GO_PGO_ENABLED
ARG GO_PGO_BENCHTIME
ARG GO_PGO_LIGHT_BENCHTIME
ARG SQLITE_EXTRA_CFLAGS

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      clang \
      cmake \
      file \
      libutfcpp-dev \
      lld \
      llvm \
      ninja-build \
      pkg-config \
      wget \
      zlib1g-dev

WORKDIR /src

COPY --link --from=source /src/go.mod /src/go.sum ./

ENV GOTOOLCHAIN=local \
    GOFLAGS=-mod=readonly

RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download && \
    go mod verify

COPY --link --from=source /src ./
COPY --link --from=jsbuilder /src/ui/build ./ui/build/
COPY --link --from=h3-builder /out/navidrome-h3 /tmp/navidrome-h3
COPY --link --from=rust-workers-builder /out/navidrome-scanner-portable /tmp/navidrome-scanner
COPY --link --from=rust-workers-builder /out/navidrome-metadata /tmp/navidrome-metadata
COPY --link --from=rust-workers-builder /out/navidrome-search /tmp/navidrome-search
COPY --link --from=rust-workers-builder /out/navidrome-integration /tmp/navidrome-integration

ENV ND_METADATAWORKERPATH=/tmp/navidrome-metadata \
    ND_SCANNERWORKERPATH=/tmp/navidrome-scanner \
    ND_SEARCHWORKERPATH=/tmp/navidrome-search \
    ND_INTEGRATIONWORKERPATH=/tmp/navidrome-integration

RUN test -x /tmp/navidrome-metadata && \
    test -x /tmp/navidrome-scanner && \
    test -x /tmp/navidrome-search && \
    test -x /tmp/navidrome-integration && \
    test -s ./ui/build/index.html && \
    test -n "$(find ./ui/build -type f -name '*.br' -print -quit)" && \
    test -n "$(find ./ui/build -type f -name '*.zst' -print -quit)" && \
    test -n "$(find ./ui/build -type f -name '*.gz' -print -quit)" && \
    test -z "$(find ./ui/build -type f -name '*.map' -print -quit)" && \
    printf '[gobuilder] embedded UI precompressed assets: br=%s zstd=%s gz=%s\n' \
      "$(find ./ui/build -type f -name '*.br' | wc -l)" \
      "$(find ./ui/build -type f -name '*.zst' | wc -l)" \
      "$(find ./ui/build -type f -name '*.gz' | wc -l)"

RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    ND_METADATAWORKERPATH=/tmp/navidrome-metadata \
    go test -p "${NAVIDROME_BUILD_CORES}" ./conf ./server && \
    ND_METADATAWORKERPATH=/tmp/navidrome-metadata \
    NAVIDROME_H3_INTEGRATION_BINARY=/tmp/navidrome-h3 \
      go test -p 1 ./server -run '^TestRustHTTP3EndToEnd$' -count=1

ENV GOAMD64=${GOAMD64_VERSION} \
    CGO_ENABLED=1 \
    CC=clang \
    CXX=clang++

# Generate a reproducible Go PGO profile from Navidrome's own representative
# hot-path benchmarks. Use thin LTO here to keep profile collection fast; the
# final application build below switches to full (fat) LTO with the merged profile.
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    set -eux; \
    if [ "${GO_PGO_ENABLED}" != "true" ]; then \
      echo '[gobuilder] Go PGO training disabled'; \
      exit 0; \
    fi; \
    export CGO_CFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_THIN_LTO_FLAGS} ${SQLITE_EXTRA_CFLAGS}" && \
    export CGO_CXXFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_THIN_LTO_FLAGS}" && \
    export CGO_LDFLAGS="${LLVM_THIN_LTO_FLAGS} ${LLD_FLAGS}" && \
    ND_SCANNERWORKERPATH=/tmp/navidrome-scanner \
    ND_METADATAWORKERPATH=/tmp/navidrome-metadata \
    ND_SEARCHWORKERPATH=/tmp/navidrome-search \
    ND_INTEGRATIONWORKERPATH=/tmp/navidrome-integration \
    PGO_BUILD_TAGS='netgo osusergo sqlite_fts5 sqlite_foreign_keys sqlite_stat4 embed' \
      GO_PGO_BENCHTIME="${GO_PGO_BENCHTIME}" \
      GO_PGO_LIGHT_BENCHTIME="${GO_PGO_LIGHT_BENCHTIME}" \
      PGO_OUTPUT=/tmp/default.pgo \
      ./release/pgo-train.sh

ENV CGO_CFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS} ${SQLITE_EXTRA_CFLAGS}" \
    CGO_CXXFLAGS="${CPU_OPTIMIZATION_FLAGS} ${LLVM_FAT_LTO_FLAGS}" \
    CGO_LDFLAGS="${LLVM_FAT_LTO_FLAGS} ${LLD_FLAGS}"

RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    GIT_SHA="$(cat /src/.git_sha 2>/dev/null || echo dev)" && \
    SOURCE_DATE_EPOCH="$(cat /src/.git_epoch 2>/dev/null || echo 0)" && \
    EXTLDFLAGS="${LLVM_FAT_LTO_FLAGS} ${LLD_FLAGS}" && \
    if [ "${GO_PGO_ENABLED}" = "true" ]; then \
      test -s /tmp/default.pgo; \
      PGO_FLAG='-pgo=/tmp/default.pgo'; \
    else \
      PGO_FLAG='-pgo=off'; \
    fi && \
    export SOURCE_DATE_EPOCH && \
    mkdir -p /out && \
    GOOS=linux GOARCH=amd64 go build \
      -p "${NAVIDROME_BUILD_CORES}" \
      "${PGO_FLAG}" \
      -trimpath \
      -buildvcs=false \
      -tags="netgo osusergo sqlite_fts5 sqlite_foreign_keys sqlite_stat4 embed" \
      -ldflags="-linkmode=external -extld=clang -extldflags '${EXTLDFLAGS}' -s -w -buildid= -X github.com/navidrome/navidrome/consts.gitSha=${GIT_SHA} -X github.com/navidrome/navidrome/consts.gitTag=${NAVIDROME_REF}-${GIT_SHA}" \
      -o /out/navidrome . && \
    file /out/navidrome && \
    go version -m /out/navidrome && \
    deps="$(ldd /out/navidrome 2>/dev/null || true)" && \
    case "$deps" in *"not found"*) echo "$deps" >&2; exit 1 ;; *) : ;; esac

# =========================================================
# Timezone data
# =========================================================

FROM ${DEBIAN_IMAGE} AS tzdata-extract

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends tzdata

# =========================================================
# Runtime
# =========================================================

FROM ${DEBIAN_IMAGE} AS release

LABEL org.opencontainers.image.authors="JBS Networks" \
      org.opencontainers.image.title="JBS Navidrome Ultra 6.1 Slim v10.4 Stable Final" \
      org.opencontainers.image.description="AMD EPYC Zen3 optimized Navidrome with static Opus/MP3, native AAC/FLAC, jemalloc light profile and Rust helpers" \
      org.opencontainers.image.source="https://github.com/TAE-OK-11/navidrome" \
      org.opencontainers.image.vendor="JBS Networks" \
      jbs.optimization="JBS-Navidrome-Ultra-6.1-Slim-v10.4/AMD-EPYC-Zen3/Go1.27/Bun1.4/Rust1.98/FFmpeg8.1.2/LLVM-FatLTO/Go-PGO/BR11-Zstd19-Gzip9/NoSourceMaps/SQLite-Light/Resource-Aware"

COPY --link --from=source /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      libwebp7 \
      libwebpdemux2 && \
    rm -rf \
      /var/lib/apt/lists/* \
      /usr/share/doc \
      /usr/share/man \
      /usr/share/info \
      /usr/share/lintian \
      /usr/share/linda \
      /usr/share/common-licenses \
      /usr/share/locale

RUN mkdir -p /usr/share/zoneinfo/Asia

COPY --link --from=tzdata-extract /usr/share/zoneinfo/Asia/Seoul /usr/share/zoneinfo/Asia/Seoul

RUN ln -snf /usr/share/zoneinfo/Asia/Seoul /etc/localtime && \
    echo "Asia/Seoul" > /etc/timezone

COPY --link --from=ffmpeg-builder /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg.real
COPY --link --from=ffmpeg-builder /usr/local/bin/ffprobe /usr/local/bin/ffprobe
COPY --link --from=jemalloc-builder /usr/local/lib/libjemalloc.so.2 /usr/local/lib/

RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf && \
    for lib in webp webpdemux; do \
      target="$(find /usr/lib /lib -type f -name "lib${lib}.so.*" -print 2>/dev/null | sort -V | tail -n 1)"; \
      [ -n "$target" ] || { echo "missing native lib${lib}" >&2; exit 1; }; \
      ln -sf "$target" "/usr/local/lib/lib${lib}.so"; \
    done && \
    ldconfig

RUN cat > /usr/local/bin/ffmpeg <<'SH'
#!/bin/sh
case "${FFMPEG_THREADS:-1}" in
    ''|*[!0-9]*) threads=1 ;;
    *) threads="${FFMPEG_THREADS}" ;;
esac

if [ "$threads" -lt 1 ] 2>/dev/null; then
    threads=1
fi

exec /usr/local/bin/ffmpeg.real \
    -nostdin \
    -hide_banner \
    -nostats \
    -loglevel warning \
    -threads "$threads" \
    -filter_threads "$threads" \
    "$@"
SH

RUN chmod 755 /usr/local/bin/ffmpeg

RUN printf '%s\n' 'navidrome:x:1000:1000:Navidrome:/nonexistent:/usr/sbin/nologin' >> /etc/passwd && \
    printf '%s\n' 'navidrome:x:1000:' >> /etc/group && \
    install -d -o 1000 -g 1000 -m 755 \
      /app \
      /data \
      /music \
      /cache \
      /cache/tmp && \
    touch /.nddockerenv

COPY --link --chown=1000:1000 --chmod=750 --from=gobuilder /out/navidrome /app/navidrome
COPY --link --chown=1000:1000 --chmod=750 --from=h3-builder /out/navidrome-h3 /app/navidrome-h3
COPY --link --chown=1000:1000 --chmod=750 --from=rust-workers-builder /out/navidrome-metadata /app/navidrome-metadata
COPY --link --chown=1000:1000 --chmod=750 --from=rust-workers-builder /out/navidrome-apikeys /app/navidrome-apikeys
COPY --link --chown=1000:1000 --chmod=750 --from=rust-workers-builder /out/navidrome-scanner /app/navidrome-scanner
COPY --link --chown=1000:1000 --chmod=750 --from=rust-workers-builder /out/navidrome-search /app/navidrome-search
COPY --link --chown=1000:1000 --chmod=750 --from=rust-workers-builder /out/navidrome-integration /app/navidrome-integration
COPY --link --chmod=755 --from=rust-builder /out/jbs-helper /usr/local/bin/jbs-helper

RUN ln -s /usr/local/bin/jbs-helper /usr/local/bin/healthcheck && \
    ln -s /usr/local/bin/jbs-helper /usr/local/bin/jbs-sqlite-maint && \
    ln -s /usr/local/bin/jbs-helper /usr/local/bin/jbs-cache-warm && \
    ln -s /usr/local/bin/jbs-helper /usr/local/bin/jbs-ffmpeg-preflight

RUN test -x /app/navidrome && \
    test -x /app/navidrome-h3 && \
    test -x /app/navidrome-metadata && \
    test -x /app/navidrome-apikeys && \
    test -x /app/navidrome-scanner && \
    test -x /app/navidrome-search && \
    test -x /app/navidrome-integration && \
    test -s /etc/ssl/certs/ca-certificates.crt && \
    test -x /usr/local/bin/ffmpeg.real && \
    test -x /usr/local/bin/ffprobe && \
    test -x /usr/local/bin/jbs-helper && \
    test -L /usr/local/bin/healthcheck && \
    test -L /usr/local/bin/jbs-sqlite-maint && \
    test -L /usr/local/bin/jbs-cache-warm && \
    test -L /usr/local/bin/jbs-ffmpeg-preflight && \
    libs="$(ldconfig -p)" && \
    case "$libs" in *libjemalloc.so.2*) : ;; *) echo "missing libjemalloc.so.2" >&2; exit 1 ;; esac && \
    navdeps="$(ldd /app/navidrome 2>/dev/null || true)" && \
    ffdeps="$(ldd /usr/local/bin/ffmpeg.real 2>/dev/null || true)" && \
    case "$navdeps $ffdeps" in *"not found"*) echo "$navdeps" >&2; echo "$ffdeps" >&2; exit 1 ;; *) : ;; esac && \
    case "$ffdeps" in \
      *libopus.so*|*libmp3lame.so*) \
        echo "FFmpeg dynamically links to libopus/libmp3lame; expected static link" >&2; \
        echo "$ffdeps" >&2; \
        exit 1 ;; \
      *) : ;; \
    esac && \
    /usr/local/bin/jbs-ffmpeg-preflight --strict

RUN cat > /entrypoint <<'SH'
#!/bin/sh
set -eu

is_true() {
    case "${1:-}" in
        1|true|TRUE|True|yes|YES|Yes|on|ON|On) return 0 ;;
        *) return 1 ;;
    esac
}

has_ffmpeg_entry() {
    output="$1"
    wanted="$2"

    while IFS= read -r line; do
        set -- $line
        [ "$#" -ge 2 ] || continue
        entries="$2"
        old_ifs="$IFS"
        IFS=,

        for entry in $entries; do
            if [ "$entry" = "$wanted" ]; then
                IFS="$old_ifs"
                return 0
            fi
        done

        IFS="$old_ifs"
    done <<EOF
$output
EOF

    return 1
}

is_auto() {
    case "${1:-}" in
        ""|auto|AUTO|Auto) return 0 ;;
        *) return 1 ;;
    esac
}

valid_uint() {
    case "${1:-}" in
        ""|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

nproc_safe() {
    value="$(nproc 2>/dev/null || true)"
    if ! valid_uint "$value" || [ "$value" -lt 1 ] 2>/dev/null; then
        value=1
    fi
    echo "$value"
}

detect_cpu_cores() {
    host_cores="$(nproc_safe)"
    quota_cores=0

    if [ -r /sys/fs/cgroup/cpu.max ]; then
        read -r quota period < /sys/fs/cgroup/cpu.max || true
        if valid_uint "${quota:-}" && \
           valid_uint "${period:-}" && \
           [ "$period" -gt 0 ] 2>/dev/null; then
            quota_cores=$(( (quota + period - 1) / period ))
        fi
    fi

    if [ "$quota_cores" -le 0 ] 2>/dev/null; then
        for base in /sys/fs/cgroup/cpu /sys/fs/cgroup/cpu,cpuacct; do
            if [ -r "${base}/cpu.cfs_quota_us" ] && \
               [ -r "${base}/cpu.cfs_period_us" ]; then
                read -r quota < "${base}/cpu.cfs_quota_us" || true
                read -r period < "${base}/cpu.cfs_period_us" || true

                if valid_uint "${quota:-}" && \
                   valid_uint "${period:-}" && \
                   [ "$quota" -gt 0 ] 2>/dev/null && \
                   [ "$period" -gt 0 ] 2>/dev/null; then
                    quota_cores=$(( (quota + period - 1) / period ))
                    break
                fi
            fi
        done
    fi

    if [ "$quota_cores" -gt 0 ] 2>/dev/null && \
       [ "$quota_cores" -lt "$host_cores" ] 2>/dev/null; then
        echo "$quota_cores"
    else
        echo "$host_cores"
    fi
}

detect_memory_mib() {
    if [ -r /sys/fs/cgroup/memory.max ]; then
        read -r max < /sys/fs/cgroup/memory.max || true
        case "${max:-}" in
            ""|max|*[!0-9]*) ;;
            *)
                if [ "$max" -gt 0 ] 2>/dev/null && \
                   [ "$max" -lt 9223372036854771712 ] 2>/dev/null; then
                    echo $(( max / 1048576 ))
                    return 0
                fi
                ;;
        esac
    fi

    for file in \
        /sys/fs/cgroup/memory/memory.limit_in_bytes \
        /sys/fs/cgroup/memory.limit_in_bytes
    do
        if [ -r "$file" ]; then
            read -r max < "$file" || true
            if valid_uint "${max:-}" && \
               [ "$max" -gt 0 ] 2>/dev/null && \
               [ "$max" -lt 9223372036854771712 ] 2>/dev/null; then
                echo $(( max / 1048576 ))
                return 0
            fi
        fi
    done

    while IFS=' ' read -r key value unit; do
        case "$key" in
            MemTotal:)
                if valid_uint "$value"; then
                    echo $(( value / 1024 ))
                    return 0
                fi
                ;;
        esac
    done < /proc/meminfo

    echo 0
}

cap_uint() {
    value="$1"
    min="$2"
    max="$3"

    if ! valid_uint "$value"; then
        value="$min"
    fi

    if [ "$value" -lt "$min" ] 2>/dev/null; then
        value="$min"
    fi

    if valid_uint "$max" && \
       [ "$max" -gt 0 ] 2>/dev/null && \
       [ "$value" -gt "$max" ] 2>/dev/null; then
        value="$max"
    fi

    echo "$value"
}

autotune_resources() {
    if ! is_true "${JBS_AUTOTUNE:-true}"; then
        if is_auto "${GOMAXPROCS:-}"; then
            unset GOMAXPROCS
        fi
        if is_auto "${GOMEMLIMIT:-}"; then
            unset GOMEMLIMIT
        fi
        if is_auto "${FFMPEG_THREADS:-}"; then
            export FFMPEG_THREADS=1
        fi
        if is_auto "${ND_DEVSCANNERTHREADS:-}"; then
            export ND_DEVSCANNERTHREADS=1
        fi
        echo "[entrypoint] autotune disabled; automatic values sanitized" >&2
        return 0
    fi

    cores="$(detect_cpu_cores)"
    mem_mib="$(detect_memory_mib)"

    if ! valid_uint "$cores" || [ "$cores" -lt 1 ] 2>/dev/null; then
        cores=1
    fi

    if ! valid_uint "$mem_mib"; then
        mem_mib=0
    fi

    if is_auto "${GOMAXPROCS:-}"; then
        max="${JBS_GOMAXPROCS_MAX:-4}"
        if ! valid_uint "$max" || [ "$max" -lt 1 ] 2>/dev/null; then
            max=4
        fi
        export GOMAXPROCS="$(cap_uint "$cores" 1 "$max")"
    fi

    if is_auto "${FFMPEG_THREADS:-}"; then
        max="${JBS_FFMPEG_THREADS_MAX:-2}"
        if ! valid_uint "$max" || [ "$max" -lt 1 ] 2>/dev/null; then
            max=2
        fi

        tuned_ffmpeg=$(( cores / 2 ))
        [ "$tuned_ffmpeg" -lt 1 ] && tuned_ffmpeg=1
        export FFMPEG_THREADS="$(cap_uint "$tuned_ffmpeg" 1 "$max")"
    fi

    gmem_limit="${GOMEMLIMIT:-${JBS_GOMEMLIMIT:-}}"

    if is_auto "$gmem_limit"; then
        percent="${JBS_GOMEMLIMIT_PERCENT:-55}"
        min_mib="${JBS_GOMEMLIMIT_MIN_MIB:-192}"
        max_mib="${JBS_GOMEMLIMIT_MAX_MIB:-4096}"

        if ! valid_uint "$percent" || \
           [ "$percent" -lt 10 ] 2>/dev/null || \
           [ "$percent" -gt 95 ] 2>/dev/null; then
            percent=55
        fi

        if ! valid_uint "$min_mib" || [ "$min_mib" -lt 64 ] 2>/dev/null; then
            min_mib=192
        fi

        if ! valid_uint "$max_mib" || [ "$max_mib" -lt 64 ] 2>/dev/null; then
            max_mib=4096
        fi

        if [ "$mem_mib" -gt 0 ] 2>/dev/null; then
            tuned_mem=$(( mem_mib * percent / 100 ))
            effective_min="$min_mib"

            if [ "$tuned_mem" -lt "$effective_min" ] 2>/dev/null; then
                effective_min=32
                if [ "$tuned_mem" -lt "$effective_min" ] 2>/dev/null; then
                    effective_min="$tuned_mem"
                fi
            fi
        else
            tuned_mem="$max_mib"
            effective_min="$min_mib"
        fi

        if [ "$max_mib" -lt "$effective_min" ] 2>/dev/null; then
            max_mib="$effective_min"
        fi

        export GOMEMLIMIT="$(cap_uint "$tuned_mem" "$effective_min" "$max_mib")MiB"
    else
        export GOMEMLIMIT="$gmem_limit"
    fi

    if is_auto "${JBS_CACHE_WARM_LIMIT_MB:-}"; then
        if [ "$mem_mib" -le 0 ] 2>/dev/null; then
            warm=32
        elif [ "$mem_mib" -le 1024 ] 2>/dev/null; then
            warm=0
        elif [ "$mem_mib" -le 2048 ] 2>/dev/null; then
            warm=64
        elif [ "$mem_mib" -le 4096 ] 2>/dev/null; then
            warm=128
        else
            warm=256
        fi
        export JBS_CACHE_WARM_LIMIT_MB="$warm"
    fi

    if is_auto "${ND_DEVSCANNERTHREADS:-}"; then
        scanner_threads="${GOMAXPROCS:-$cores}"

        if ! valid_uint "$scanner_threads" || \
           [ "$scanner_threads" -lt 1 ] 2>/dev/null; then
            scanner_threads=1
        fi

        if [ "$mem_mib" -gt 0 ] 2>/dev/null && \
           [ "$mem_mib" -le 512 ] 2>/dev/null; then
            scanner_max=1
        elif [ "$mem_mib" -gt 0 ] 2>/dev/null && \
             [ "$mem_mib" -le 2048 ] 2>/dev/null; then
            scanner_max=2
        else
            scanner_max=4
        fi

        if [ "$scanner_max" -gt 1 ] 2>/dev/null; then
            scanner_threads=$(( scanner_threads + 1 ))
        fi

        export ND_DEVSCANNERTHREADS="$(
            cap_uint "$scanner_threads" 1 "$scanner_max"
        )"
    fi

    echo "[entrypoint] autotune: cores=${cores} mem=${mem_mib}MiB GOMAXPROCS=${GOMAXPROCS:-unset} GOMEMLIMIT=${GOMEMLIMIT:-unset} FFMPEG_THREADS=${FFMPEG_THREADS:-unset} SCANNER_THREADS=${ND_DEVSCANNERTHREADS:-unset} CACHE_WARM=${JBS_CACHE_WARM_LIMIT_MB:-unset}MB" >&2
}

check_writable_dir() {
    dir="$1"
    label="$2"

    if [ ! -d "$dir" ]; then
        echo "[entrypoint] fatal: ${label} directory does not exist: $dir" >&2
        exit 1
    fi

    if [ ! -w "$dir" ]; then
        echo "[entrypoint] fatal: ${label} directory is not writable by uid=$(id -u): $dir" >&2
        exit 1
    fi

    tmp="${dir}/.jbs-write-test.$$"

    if ! ( : > "$tmp" ) 2>/dev/null; then
        echo "[entrypoint] fatal: cannot create files in ${label} directory: $dir" >&2
        exit 1
    fi

    rm -f "$tmp"
}

check_runtime_paths() {
    data_dir="${ND_DATAFOLDER:-/data}"
    cache_dir="${ND_CACHEFOLDER:-/cache}"
    music_dir="${ND_MUSICFOLDER:-/music}"

    [ -n "$data_dir" ] || data_dir=/data
    [ -n "$cache_dir" ] || cache_dir=/cache
    [ -n "$music_dir" ] || music_dir=/music

    mkdir -p "${cache_dir}/tmp" 2>/dev/null || true

    check_writable_dir "$data_dir" data
    check_writable_dir "$cache_dir" cache
    check_writable_dir "${cache_dir}/tmp" cache-tmp

    if [ ! -d "$music_dir" ]; then
        echo "[entrypoint] fatal: music directory does not exist: $music_dir" >&2
        exit 1
    fi

    if [ ! -r "$music_dir" ] || [ ! -x "$music_dir" ]; then
        echo "[entrypoint] fatal: music directory is not readable/searchable by uid=$(id -u): $music_dir" >&2
        exit 1
    fi

    db_path="${ND_DBPATH:-${data_dir}/navidrome.db}"

    case "$db_path" in
        file:*)
            db_path="${db_path#file:}"
            db_path="${db_path%%\?*}"
            ;;
        *:memory:*|"")
            db_path=""
            ;;
    esac

    if [ -n "$db_path" ]; then
        if [ -e "$db_path" ] && [ ! -w "$db_path" ]; then
            echo "[entrypoint] fatal: database file is not writable by uid=$(id -u): $db_path" >&2
            exit 1
        fi

        case "$db_path" in
            /*) db_dir="${db_path%/*}" ;;
            */*) db_dir="${db_path%/*}" ;;
            *) db_dir="$(pwd)" ;;
        esac

        if [ ! -d "$db_dir" ] || [ ! -w "$db_dir" ]; then
            echo "[entrypoint] fatal: database parent is not writable: $db_dir" >&2
            exit 1
        fi
    fi
}

check_rust_workers() {
    for worker in \
        "${ND_SCANNERWORKERPATH:-/app/navidrome-scanner}" \
        "${ND_METADATAWORKERPATH:-/app/navidrome-metadata}" \
        "${ND_SEARCHWORKERPATH:-/app/navidrome-search}" \
        "${ND_APIKEYSWORKERPATH:-/app/navidrome-apikeys}" \
        "${ND_INTEGRATIONWORKERPATH:-/app/navidrome-integration}"; do
        if [ ! -x "$worker" ]; then
            echo "[entrypoint] fatal: Rust worker is missing or not executable: $worker" >&2
            exit 1
        fi
    done
}

run_optional() {
    enabled="$1"
    shift

    if ! is_true "$enabled"; then
        return 0
    fi

    set +e
    "$@"
    code="$?"
    set -e

    if [ "$code" -eq 126 ] || [ "$code" -eq 127 ]; then
        echo "[entrypoint] optional helper unavailable: $* status=${code}; skipping" >&2
        return 0
    fi

    if [ "$code" -ne 0 ]; then
        echo "[entrypoint] optional helper failed: $* status=${code}; continuing" >&2
    fi

    return 0
}

run_required() {
    enabled="$1"
    shift

    if ! is_true "$enabled"; then
        return 0
    fi

    set +e
    "$@"
    code="$?"
    set -e

    if [ "$code" -ne 0 ]; then
        echo "[entrypoint] required helper failed: $* status=${code}" >&2
        exit "$code"
    fi
}

configure_allocator() {
    unset LD_PRELOAD

    if ! is_true "${JBS_USE_JEMALLOC:-true}"; then
        echo "[entrypoint] jemalloc disabled by JBS_USE_JEMALLOC=false" >&2
        return 0
    fi

    if [ ! -r /usr/local/lib/libjemalloc.so.2 ]; then
        echo "[entrypoint] jemalloc not found; using system allocator" >&2
        return 0
    fi

    set +e
    LD_PRELOAD=/usr/local/lib/libjemalloc.so.2 /bin/true >/dev/null 2>&1
    code="$?"
    set -e

    if [ "$code" -ne 0 ]; then
        echo "[entrypoint] jemalloc preload test failed status=${code}; using system allocator" >&2
        unset LD_PRELOAD
        return 0
    fi

    export LD_PRELOAD=/usr/local/lib/libjemalloc.so.2
    echo "[entrypoint] jemalloc enabled" >&2
}

ffmpeg_fallback_preflight() {
    if [ ! -x /usr/local/bin/ffmpeg.real ]; then
        echo "[entrypoint] ffmpeg.real missing or not executable" >&2
        return 1
    fi

    decoders="$(/usr/local/bin/ffmpeg.real -hide_banner -decoders 2>&1 || true)"
    encoders="$(/usr/local/bin/ffmpeg.real -hide_banner -encoders 2>&1 || true)"
    demuxers="$(/usr/local/bin/ffmpeg.real -hide_banner -demuxers 2>&1 || true)"
    muxers="$(/usr/local/bin/ffmpeg.real -hide_banner -muxers 2>&1 || true)"
    filters="$(/usr/local/bin/ffmpeg.real -hide_banner -filters 2>&1 || true)"

    for name in alac aac mp3 flac opus vorbis; do
        has_ffmpeg_entry "$decoders" "$name" || {
            echo "[entrypoint] missing FFmpeg decoder: $name" >&2
            return 1
        }
    done

    for name in libopus libmp3lame aac flac pcm_s16le; do
        has_ffmpeg_entry "$encoders" "$name" || {
            echo "[entrypoint] missing FFmpeg encoder: $name" >&2
            return 1
        }
    done

    for name in mov mp3 aac flac wav aiff ogg; do
        has_ffmpeg_entry "$demuxers" "$name" || {
            echo "[entrypoint] missing FFmpeg demuxer: $name" >&2
            return 1
        }
    done

    for name in ogg opus mp3 adts wav flac; do
        has_ffmpeg_entry "$muxers" "$name" || {
            echo "[entrypoint] missing FFmpeg muxer: $name" >&2
            return 1
        }
    done

    for name in aresample aformat volume; do
        has_ffmpeg_entry "$filters" "$name" || {
            echo "[entrypoint] missing FFmpeg filter: $name" >&2
            return 1
        }
    done

    echo "[entrypoint] FFmpeg fallback preflight ok" >&2
    return 0
}

autotune_resources
check_runtime_paths
check_rust_workers

if is_true "${JBS_FFMPEG_PREFLIGHT:-false}"; then
    if [ -x /usr/local/bin/jbs-ffmpeg-preflight ]; then
        set +e
        /usr/local/bin/jbs-ffmpeg-preflight --strict
        code="$?"
        set -e

        if [ "$code" -eq 0 ]; then
            :
        elif [ "$code" -eq 126 ] || [ "$code" -eq 127 ]; then
            echo "[entrypoint] jbs-ffmpeg-preflight unavailable; using fallback status=${code}" >&2
            run_required true ffmpeg_fallback_preflight
        else
            echo "[entrypoint] required helper failed: jbs-ffmpeg-preflight --strict status=${code}" >&2
            exit "$code"
        fi
    else
        echo "[entrypoint] jbs-ffmpeg-preflight missing; using fallback" >&2
        run_required true ffmpeg_fallback_preflight
    fi
fi

if [ -x /usr/local/bin/jbs-sqlite-maint ]; then
    run_optional "${JBS_SQLITE_MAINT:-false}" \
        /usr/local/bin/jbs-sqlite-maint startup
else
    echo "[entrypoint] jbs-sqlite-maint missing; skipping startup maintenance" >&2
fi

if is_true "${JBS_CACHE_WARM:-false}"; then
    if [ -x /usr/local/bin/jbs-cache-warm ]; then
        run_optional true \
            /usr/local/bin/jbs-cache-warm \
            --limit-mb "${JBS_CACHE_WARM_LIMIT_MB:-32}"
    else
        echo "[entrypoint] jbs-cache-warm missing; skipping cache warm" >&2
    fi
fi

configure_allocator

exec /app/navidrome "$@"
SH

RUN chmod 755 /entrypoint && \
    /bin/sh -n /entrypoint && \
    /bin/sh -n /usr/local/bin/ffmpeg

USER 1000:1000

VOLUME ["/data", "/music", "/cache"]

ARG GOMEMLIMIT
ARG GOMAXPROCS
ARG GOGC
ARG SCANSCHEDULE
ARG FFMPEG_THREADS
ARG JBS_GOMAXPROCS_MAX
ARG JBS_FFMPEG_THREADS_MAX
ARG JBS_GOMEMLIMIT_PERCENT
ARG JBS_GOMEMLIMIT_MIN_MIB
ARG JBS_GOMEMLIMIT_MAX_MIB

ENV TZ=Asia/Seoul \
    TMPDIR=/cache/tmp \
    MALLOC_CONF="background_thread:true,metadata_thp:disabled,narenas:2,dirty_decay_ms:5000,muzzy_decay_ms:10000,oversize_threshold:8388608,retain:false" \
    GOMAXPROCS=${GOMAXPROCS} \
    GOGC=${GOGC} \
    JBS_GOMEMLIMIT=${GOMEMLIMIT} \
    GODEBUG=netdns=go,madvdontneed=1 \
    FFMPEG_THREADS=${FFMPEG_THREADS} \
    JBS_AUTOTUNE=true \
    JBS_GOMAXPROCS_MAX=${JBS_GOMAXPROCS_MAX} \
    JBS_FFMPEG_THREADS_MAX=${JBS_FFMPEG_THREADS_MAX} \
    JBS_GOMEMLIMIT_PERCENT=${JBS_GOMEMLIMIT_PERCENT} \
    JBS_GOMEMLIMIT_MIN_MIB=${JBS_GOMEMLIMIT_MIN_MIB} \
    JBS_GOMEMLIMIT_MAX_MIB=${JBS_GOMEMLIMIT_MAX_MIB} \
    ND_DEVSCANNERTHREADS=auto \
    ND_ADDRESS=0.0.0.0 \
    ND_PORT=4533 \
    ND_HTTP3PROVIDER=tokio-quiche \
    ND_HTTP3GATEWAYPATH=/app/navidrome-h3 \
    ND_FFMPEGPATH=/usr/local/bin/ffmpeg \
    ND_METADATAWORKERPATH=/app/navidrome-metadata \
    ND_APIKEYSWORKERPATH=/app/navidrome-apikeys \
    ND_SCANNERWORKERPATH=/app/navidrome-scanner \
    ND_SEARCHWORKERPATH=/app/navidrome-search \
    ND_INTEGRATIONWORKERPATH=/app/navidrome-integration \
    ND_MUSICFOLDER=/music \
    ND_DATAFOLDER=/data \
    ND_CACHEFOLDER=/cache \
    ND_CONFIGFILE=/data/navidrome.toml \
    ND_DBPATH="file:/data/navidrome.db?mode=rwc&cache=private&_journal_mode=WAL&_synchronous=NORMAL&_locking_mode=NORMAL&_txlock=immediate&_busy_timeout=120000&_foreign_keys=on&_cache_size=-16384&_stmt_cache_size=96&_secure_delete=OFF" \
    ND_ENABLESCHEDULEDDBANALYZE=true \
    ND_ENFORCENONROOTUSER=true \
    ND_SCANNER_ENABLED=true \
    ND_SCANNER_SCHEDULE=${SCANSCHEDULE} \
    ND_SCANNER_SCANONSTARTUP=false \
    ND_SCANNER_WATCHERWAIT=0s \
    ND_SCANNER_PURGEMISSING=never \
    ND_SCANNER_FOLLOWSYMLINKS=false \
    ND_SCANNER_EXTRACTOR=lofty \
    ND_SEARCH_BACKEND=fts \
    ND_SEARCH_FULLSTRING=false \
    ND_SMARTPLAYLISTREFRESHDELAY=5m \
    ND_MAXSIDEBARPLAYLISTS=50 \
    ND_ENABLEDOWNLOADS=true \
    ND_ENABLETRANSCODINGCONFIG=true \
    ND_AUTOTRANSCODEDOWNLOAD=false \
    ND_DEFAULTDOWNSAMPLINGFORMAT=opus \
    ND_TRANSCODING_ENABLECANCELLATION=true \
    ND_TRANSCODING_MAXCONCURRENT=1 \
    ND_TRANSCODING_MAXCONCURRENTPERUSER=1 \
    ND_TRANSCODINGCACHESIZE=2048MiB \
    ND_IMAGECACHESIZE=256MiB \
    ND_COVERARTQUALITY=75 \
    ND_UICOVERARTSIZE=300 \
    ND_UISEARCHDEBOUNCEMS=350 \
    ND_ENABLEWEBPENCODING=false \
    ND_COVERARTPRIORITY="cover.*,folder.*,front.*,embedded,external" \
    ND_ARTISTARTPRIORITY="artist.*,album/artist.*,external" \
    ND_DISCARTPRIORITY="disc*.*,cd*.*,cover.*,folder.*,front.*,discsubtitle,embedded" \
    ND_LYRICSPRIORITY=".lrc,.txt,embedded" \
    ND_ENABLEMEDIAFILECOVERART=false \
    ND_ENABLEARTWORKPRECACHE=false \
    ND_ENABLEARTWORKUPLOAD=true \
    ND_ENABLECOVERANIMATION=false \
    ND_ENABLEREPLAYGAIN=true \
    ND_ENABLENOWPLAYING=false \
    ND_ENABLEFAVOURITES=true \
    ND_ENABLESTARRATING=true \
    ND_AUTOIMPORTPLAYLISTS=false \
    ND_PLAYLISTSPATH="" \
    ND_ENABLEEXTERNALSERVICES=true \
    ND_ENABLEINSIGHTSCOLLECTOR=false \
    ND_AGENTS="listenbrainz" \
    ND_DEEZER_ENABLED=false \
    ND_DEEZER_LANGUAGE="ko,en" \
    ND_LASTFM_ENABLED=false \
    ND_LASTFM_LANGUAGE="ko,en" \
    ND_LASTFM_SCROBBLEFIRSTARTISTONLY=false \
    ND_LISTENBRAINZ_ENABLED=true \
    ND_LISTENBRAINZ_BASEURL=https://api.listenbrainz.org/1/ \
    ND_LIBREFM_ENABLED=true \
    ND_LIBREFM_APIKEY=navidrome \
    ND_LIBREFM_SECRET=navidrome \
    ND_LIBREFM_BASEURL=https://libre.fm/2.0/ \
    ND_LIBREFM_AUTHURL=https://libre.fm/api/auth/ \
    ND_ENABLESCROBBLEHISTORY=false \
    ND_PROMETHEUS_ENABLED=false \
    ND_INSPECT_ENABLED=false \
    ND_PLUGINS_ENABLED=false \
    ND_PLUGINS_CACHESIZE=64MB \
    ND_PLUGINS_AUTORELOAD=false \
    ND_JUKEBOX_ENABLED=false \
    ND_ENABLEGRAVATAR=false \
    ND_ENABLELOGREDACTING=true \
    ND_ENABLESHARING=false \
    ND_DEFAULTLANGUAGE=ko \
    ND_DEFAULTTHEME=Dark \
    ND_LOGLEVEL=warn \
    ND_MAXIMAGEUPLOADSIZE=10MB \
    JBS_SQLITE_MAINT=false \
    JBS_CACHE_WARM=false \
    JBS_CACHE_WARM_LIMIT_MB=auto \
    JBS_FFMPEG_PREFLIGHT=false \
    JBS_USE_JEMALLOC=true

EXPOSE 4533/tcp 4533/udp

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=60s --timeout=5s --start-period=75s --retries=3 \
    CMD ["/usr/local/bin/healthcheck"]

WORKDIR /app

ENTRYPOINT ["/entrypoint"]
